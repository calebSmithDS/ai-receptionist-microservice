-- allium: 3
-- System Intent: Australian Tradie AI Receptionist Microservice
-- Architecture: Deterministic FSM + Debounced Burst Ingestion + LLM Qualification (w/ Heuristic Fallback) + CRM Lead Dispatch

--------------------------------------------------------------------------------
-- 1. ENTITIES & LIFECYCLES
--------------------------------------------------------------------------------

entity CustomerSession {
  business_id: String
  customer_phone: String  -- alias: caller_number in Redis/Zod contract
  status: INIT | AWAITING_REPLY | QUALIFYING | COMPLETED | ESCALATED | TERMINATED | ABANDONED
  
  -- Anti-Loop Counters
  user_message_count: Integer
  turn_count: Integer
  stall_count: Integer

  -- State-Dependent Collected Data
  customer_name: String when status in {QUALIFYING, COMPLETED, ESCALATED}
  suburb: String when status in {QUALIFYING, COMPLETED, ESCALATED}
  issue: String when status in {QUALIFYING, COMPLETED, ESCALATED}
  urgency: LOW | MEDIUM | HIGH | EMERGENCY when status in {QUALIFYING, COMPLETED, ESCALATED}
  escalation_reason: DANGER_HAZARD | ANGER | HUMAN_REQUEST | OUT_OF_BOUNDS | MAX_TURNS_EXCEEDED | UNKNOWN when status = ESCALATED

  -- Deterministic Transition Graph (δ: Q × Σ → Q' × Ω)
  transitions status {
    INIT -> AWAITING_REPLY
    AWAITING_REPLY -> QUALIFYING
    AWAITING_REPLY -> TERMINATED
    QUALIFYING -> QUALIFYING
    QUALIFYING -> COMPLETED
    QUALIFYING -> ESCALATED
    QUALIFYING -> TERMINATED
    QUALIFYING -> ABANDONED
    COMPLETED -> COMPLETED
    ESCALATED -> ESCALATED
    terminal: TERMINATED, ABANDONED
  }

  -- Invariants
  invariant NonNegativeTurns {
    this.turn_count >= 0 and this.user_message_count >= 0
  }

  invariant CompletedHasMinimumData {
    if this.status = COMPLETED then
      this.customer_name != null and
      this.suburb != null and
      this.issue != null
  }
}

entity MessageBuffer {
  -- Canonical upstream Ingress Buffer
  business_id: String
  customer_phone: String
  version: Integer
  pending_messages: List<String>
  media_urls: List<String>
  received_at: Timestamp
  expires_in_seconds: Integer

  invariant PositiveVersion {
    this.version >= 1
  }
}

--------------------------------------------------------------------------------
-- 2. RULES: INGESTION & DEBOUNCING (CANONICAL UPSTREAM INGRESS BUFFER)
--------------------------------------------------------------------------------

rule BufferInboundFragment {
  when: CustomerSendsSms(business_id, phone, text, media_urls)
  requires: text.length > 0 or media_urls.count > 0
  ensures:
    MessageBuffer.version = MessageBuffer.version + 1
    MessageBuffer.pending_messages.contains(text)
    MessageBuffer.media_urls.contains_all(media_urls)
    MessageBuffer.received_at = now
    Timer.scheduled(delay: 10s, token: MessageBuffer.version)
}

rule DrainBufferOnLatestTimer {
  when: DebounceTimerFires(business_id, phone, token)
  requires: token = MessageBuffer.version
  ensures:
    full_text = join(MessageBuffer.pending_messages, "\n")
    all_media = MessageBuffer.media_urls
    MessageBuffer.pending_messages = empty
    MessageBuffer.media_urls = empty
    DispatchInboundBurst(business_id, phone, full_text)
}

rule IgnoreStaleDebounceTimer {
  when: DebounceTimerFires(business_id, phone, token)
  requires: token < MessageBuffer.version
  ensures:
    noop
}

--------------------------------------------------------------------------------
-- 3. RULES: TELEPHONY & MISSED CALL GREETING (TEL-01, TEL-02)
--------------------------------------------------------------------------------

rule InterceptMissedCall {
  when: CallMissed(business_id, caller_phone)
  ensures:
    CustomerSession.status = INIT
    CustomerSession.user_message_count = 0
    Timer.scheduled(delay: 30s, job: "DispatchGreeting")
}

rule SendGreetingSms {
  when: GreetingTimerFires(session)
  requires: session.status = INIT
  ensures:
    session.status = AWAITING_REPLY
    SMS.sent(
      to: session.customer_phone,
      body: "Hi, this is " + tradie_name + "'s assistant. He's on the tools right now. How can we help you today?"
    )
}

--------------------------------------------------------------------------------
-- 4. RULES: CONVERSATION LOOP & QUALIFICATION (FSM-01 -> FSM-03)
--------------------------------------------------------------------------------

rule BouncerServiceHandoff {
  when: InboundDebouncedBurst(business_id, phone, full_text)
  requires:
    IntentSession.status = resolved_service and
    session.status = INIT
  ensures:
    -- Bypasses 30-second greeting since contact already replied to neutral SMS
    session.status = QUALIFYING
    session.user_message_count = 1
    session.stall_count = 0
    DispatchToEvaluation(business_id, phone, full_text)
}

rule StartQualifyingOnReply {
  when: DispatchInboundBurst(business_id, phone, full_text)
  requires: session.status = AWAITING_REPLY
  ensures:
    session.status = QUALIFYING
    session.user_message_count = 1
    DispatchToEvaluation(business_id, phone, full_text)
}

rule EvaluateInboundWithGeminiOrOfflineFallback {
  when: DispatchToEvaluation(business_id, phone, full_text)
  requires: session.status = QUALIFYING
  ensures:
    if LLM.is_available then
      QualificationEvaluated(session, Gemini.evaluate(full_text))
    else
      -- Deterministic heuristic fallback when Gemini API is unavailable or unconfigured
      QualificationEvaluated(session, OfflineHeuristics.evaluate(full_text))
}

rule StepQualification {
  when: QualificationEvaluated(session, extracted, is_fully_qualified)
  requires: session.status = QUALIFYING and is_fully_qualified = false
  ensures:
    session.status = QUALIFYING
    session.customer_name = coalesce(extracted.name, session.customer_name)
    session.suburb = coalesce(extracted.suburb, session.suburb)
    session.issue = coalesce(extracted.issue, session.issue)
    session.urgency = coalesce(extracted.urgency, session.urgency)
    -- Reset stall counter if progress was made on qualification fields
    if (extracted.name != null or extracted.suburb != null or extracted.issue != null or extracted.urgency != null) then
      session.stall_count = 0
    else
      session.stall_count = session.stall_count + 1
    SMS.sent(to: session.customer_phone, body: extracted.follow_up_question)
}

rule CompleteQualification {
  when: QualificationEvaluated(session, extracted, is_fully_qualified)
  requires: 
    session.status = QUALIFYING and
    is_fully_qualified = true
  ensures:
    session.status = COMPLETED
    session.customer_name = coalesce(extracted.name, session.customer_name)
    session.suburb = coalesce(extracted.suburb, session.suburb)
    session.issue = coalesce(extracted.issue, session.issue)
    Lead.dispatched_to_crm(system: "ServiceM8", data: session)
    SMS.sent(to: Owner.phone, alert: "New Lead Dispatched", data: session)
    SMS.sent(to: session.customer_phone, framing: "on_site_inspection_quote")
}

--------------------------------------------------------------------------------
-- 5. RULES: SAFETY, ESCALATION & SPAM (FSM-04, FSM-05)
--------------------------------------------------------------------------------

rule DetectSpamSilently {
  when: InboundClassifiedAsSpam(session)
  requires: session.status in {AWAITING_REPLY, QUALIFYING}
  ensures:
    session.status = TERMINATED
    SMS.outbound_count = 0  -- $0 cost gate
}

rule EscalateImmediateHazardOrHumanRequest {
  when: HazardOrEscalationDetected(session, reason)
  requires: session.status in {AWAITING_REPLY, QUALIFYING}
  ensures:
    session.status = ESCALATED
    session.escalation_reason = reason
    MuteMagicLink.token = generate_token()
    SMS.sent(
      to: Owner.phone,
      alert: "Escalation Alert",
      details: session,
      action: "Contact customer immediately",
      magic_link: MuteMagicLink.url
    )
    SMS.sent(to: session.customer_phone, body: "Passed to team lead directly")
}

--------------------------------------------------------------------------------
-- 6. RULES: ANTI-LOOP BOUNDARIES (FSM-06, FSM-07)
--------------------------------------------------------------------------------

rule SendUltimatumOnFourthStall {
  when: StalledTurnEvaluated(session)
  requires: session.status = QUALIFYING and session.stall_count = 3
  ensures:
    session.status = QUALIFYING
    SMS.sent(to: session.customer_phone, type: "Ultimatum")
}

rule AbandonSessionOnFifthStall {
  when: StalledTurnEvaluated(session)
  requires: session.status = QUALIFYING and session.stall_count >= 4
  ensures:
    session.status = ABANDONED
    Session.dropped_silently = true
}

--------------------------------------------------------------------------------
-- 7. RULES: LATCHING & POST-COMPLETION HAND-OFF (TEL-03)
--------------------------------------------------------------------------------

rule ForwardCustomerFollowUpToOwner {
  when: CustomerSendsSms(business_id, phone, text)
  requires: session.status in {COMPLETED, ESCALATED}
  ensures:
    session.status = session.status  -- remains in latching state
    SMS.sent(to: Owner.phone, body: text, header: "Follow-up")
    Bot.replies_to_customer = false  -- bot maintains radio silence
}
