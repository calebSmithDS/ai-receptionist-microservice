TWILIO_AUTH_TOKEN=

# Telnyx Credentials (Optional alternative)
TELNYX_API_KEY=

# LLM Engine (OpenAI for GPT-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Parent WaaS Webhook / Lead Security
LEAD_WEBHOOK_SECRET=your-shared-secret-key
